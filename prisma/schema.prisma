generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum MessageStatus {
  NEW
  READ
  REPLIED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(ADMIN)
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameAr      String
  nameEn      String
  descriptionAr String?
  descriptionEn String?
  order       Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@map("categories")
}

model Project {
  id            String    @id @default(cuid())
  slug          String    @unique
  titleAr       String
  titleEn       String
  descriptionAr String    @db.Text
  descriptionEn String    @db.Text
  client        String?
  location      String?
  year          Int?
  featured      Boolean   @default(false)
  published     Boolean   @default(true)
  order         Int       @default(0)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images        Image[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([categoryId])
  @@index([published, featured])
  @@map("projects")
}

model Service {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleAr       String
  titleEn       String
  descriptionAr String   @db.Text
  descriptionEn String   @db.Text
  icon          String?
  image         String?
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

model Image {
  id        String   @id @default(cuid())
  url       String
  altAr     String?
  altEn     String?
  order     Int      @default(0)
  isCover   Boolean  @default(false)
  imageHash String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([imageHash])
  @@map("images")
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("messages")
}

model Testimonial {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  roleAr    String?
  roleEn    String?
  contentAr String   @db.Text
  contentEn String   @db.Text
  rating    Int      @default(5)
  avatar    String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model FAQ {
  id         String   @id @default(cuid())
  questionAr String
  questionEn String
  answerAr   String   @db.Text
  answerEn   String   @db.Text
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("faqs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueAr   String?  @db.Text
  valueEn   String?  @db.Text
  value     String?  @db.Text
  type      String   @default("text")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SEO {
  id              String   @id @default(cuid())
  page            String   @unique
  titleAr         String?
  titleEn         String?
  descriptionAr   String?  @db.Text
  descriptionEn   String?  @db.Text
  keywordsAr      String?
  keywordsEn      String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)
  structuredData  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("seo")
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_links")
}

model FloatingLink {
  id           String   @id @default(cuid())
  labelAr      String
  labelEn      String
  url          String
  icon         String   @default("link")
  color        String   @default("green")
  order        Int      @default(0)
  active       Boolean  @default(true)
  openInNewTab Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("floating_links")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(ADMIN)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model BackupLog {
  id        String   @id @default(cuid())
  filename  String
  size      Int?
  status    String   @default("completed")
  createdAt DateTime @default(now())

  @@map("backup_logs")
}
