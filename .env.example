# Database (Supabase PostgreSQL)
# Use session pooler / direct connection on port 5432 for Prisma runtime.
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Direct connection for migrations and seed (same host, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Avoid transaction pooler (port 6543) with Prisma — it often fails locally.

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="project-images"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AM CNC WOOD DESIGN"
NEXT_PUBLIC_WHATSAPP_PHONE="966500000000"

# Note: Use DIRECT_URL for prisma db push (port 5432, not pgbouncer 6543)
