# Database (Supabase PostgreSQL)
# Dev/runtime: use session pooler on port 5432 (DIRECT_URL).
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Same host/port 5432 — used by Prisma in local development.
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Avoid port 6543 (transaction pooler) unless you add ?pgbouncer=true.
# If the DB times out: open Supabase dashboard → Project Settings → wake/unpause the project.

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="project-images"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AM CNC WOOD DESIGN"
NEXT_PUBLIC_WHATSAPP_PHONE="966500000000"

# Note: Use DIRECT_URL for prisma db push (port 5432, not pgbouncer 6543)
